{
  "name": "popingui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "build/main.cjs",
  "description": "Массовая проверка доступности с диагностикой способа блокировки (DNS / PING / TCP / TLS-SNI / HTTP / UDP)",
  "author": "popingui",
  "scripts": {
    "check": "node scripts/check-all.mjs",
    "dev": "concurrently -k -n server,ui -c cyan,magenta \"npm:dev:server\" \"npm:dev:ui\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:ui": "vite",
    "build": "vite build",
    "start": "npm run build && cross-env NODE_ENV=production tsx server/index.ts",
    "icons": "node scripts/make-icons.mjs",
    "build:main": "node scripts/build-main.mjs",
    "app": "npm run icons && npm run build:main && concurrently -k -n ui,app -c magenta,green \"npm:dev:ui\" \"npm:app:electron\"",
    "app:electron": "electron .",
    "app:build": "npm run icons && npm run build && cross-env NODE_ENV=production npm run build:main && electron-builder --win",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
